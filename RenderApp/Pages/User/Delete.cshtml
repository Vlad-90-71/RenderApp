@page "{id:int}"
@model RenderApp.Pages.User.DeleteModel
@{
    ViewData["Title"] = "Удалить пользователя";
}

<h2>Удалить пользователя</h2>

<p>Вы уверены, что хотите удалить пользователя <strong>@Model.EntityUser?.Name</strong>?</p>

<form method="post">
    <button type="submit" class="btn btn-danger">Удалить</button>
    <a asp-page="Index" class="btn btn-secondary">Отмена</a>
</form>
