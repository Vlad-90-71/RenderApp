@page
@model RenderApp.Pages.SystemInfo.SystemInfoModel

<h2>Информация о контейнере</h2>

<p><strong>CPU Limit:</strong> @Model.CpuLimit</p>
<p><strong>CPU Usage:</strong> @Model.CpuUsage</p>
<p><strong>Memory Limit:</strong> @Model.MemoryLimit</p>
<p><strong>Memory Usage:</strong> @Model.MemoryUsage</p>

<h3>Диски:</h3>
<table>
    <thead>
        <tr><th>Диск</th><th>Всего (GB)</th><th>Свободно (GB)</th></tr>
    </thead>
    <tbody>
        @foreach (var disk in Model.Disks)
        {
            <tr>
                <td>@disk.Drive</td>
                <td>@disk.Total</td>
                <td>@disk.Free</td>
            </tr>
        }
    </tbody>
</table>
